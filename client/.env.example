# Public API origin, without /api. Both H5 and WeChat use the -h ingress host.
# The production H5 host does not proxy /api; Nginx serves only its static build.
# For local-only H5 development, leave this value empty to use the :10087 dev proxy.
TARO_APP_API_BASE_URL=https://xiaoman-h.942295.xyz

