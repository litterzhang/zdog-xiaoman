BABY_HOST=127.0.0.1
BABY_PORT=8083
BABY_DATABASE=.data/baby.sqlite3
BABY_ALLOWED_ORIGINS=http://127.0.0.1:10087,http://localhost:10087,https://xiaomanh5-h.942295.xyz,https://xiaomanh5.942295.xyz
BABY_ALLOWED_HOSTS=localhost,127.0.0.1,xiaoman.942295.xyz,xiaoman-h.942295.xyz
# Provision a separate baby client in zdog-auth; never reuse another app's secret.
ZDOG_AUTH_ISSUER=https://auth.example.com
ZDOG_AUTH_CLIENT_ID=
ZDOG_AUTH_CLIENT_SECRET=

# Public barcode catalogs only. No inventory or authentication data is sent upstream.
BABY_CATALOG_HTTP_PROXY=
BABY_CATALOG_USER_AGENT=Xiaoman/0.1.1 (https://xiaomanh5-h.942295.xyz)

# Durable public-product cache; default is catalog.sqlite3 beside BABY_DATABASE.
BABY_CATALOG_DATABASE=
# Server-only supplier key. Never set this in the client environment.
APIZERO_API_KEY=
# Application-wide rolling 24-hour GS1 budget; maximum 5 with Key, 2 anonymously.
BABY_GS1_DAILY_LIMIT=5
